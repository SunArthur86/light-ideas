<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<title>诗词地图 · 跟着古诗游中国</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
:root{--bg:#faf9f7;--surface:#fff;--text:#1d1d1f;--text2:#6e6e73;--text3:#aeaeb2;--accent:#c0392b;--accent2:#e74c3c;--warm:#fff8f0;--border:#e5e5ea;--shadow:0 2px 16px rgba(0,0,0,.06);--radius:16px;--radius-sm:12px}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","PingFang SC","Hiragino Sans GB","Microsoft YaHei",serif;background:var(--bg);color:var(--text);height:100vh;display:flex;flex-direction:column;overflow:hidden;-webkit-tap-highlight-color:transparent}

nav{position:sticky;top:0;z-index:500;height:48px;display:flex;align-items:center;padding:0 16px;gap:10px;background:rgba(250,249,247,.88);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid var(--border);flex-shrink:0}
nav .back{color:var(--accent);text-decoration:none;font-size:14px;font-weight:500}
nav .title{font-size:15px;font-weight:700;letter-spacing:-.3px;flex:1}
nav .sub{font-size:10px;color:var(--text3)}

.main{display:flex;flex:1;overflow:hidden}
#map{flex:1;background:#f0eeeb}

.sidebar{width:340px;border-left:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;background:var(--bg)}
.sidebar-hdr{padding:14px 16px 10px;border-bottom:1px solid var(--border)}
.sidebar-hdr h2{font-size:18px;font-weight:700;letter-spacing:-.3px;font-family:"Noto Serif SC",Georgia,serif}
.sidebar-hdr .count{font-size:11px;color:var(--text3);margin-top:2px}

.filters{padding:8px 12px;display:flex;flex-wrap:wrap;gap:4px;border-bottom:1px solid var(--border)}
.chip{padding:3px 10px;border-radius:14px;font-size:11px;cursor:pointer;background:var(--surface);border:1px solid var(--border);color:var(--text2);transition:all .2s;white-space:nowrap}
.chip:hover{border-color:var(--accent);color:var(--accent)}
.chip.on{background:var(--accent);color:#fff;border-color:var(--accent)}

.search-row{padding:8px 12px;border-bottom:1px solid var(--border)}
.search-row input{width:100%;padding:7px 12px;border:1px solid var(--border);border-radius:8px;font-size:12px;background:var(--surface);outline:none;transition:border .2s}
.search-row input:focus{border-color:var(--accent)}
.search-row input::placeholder{color:var(--text3)}

.poem-list{flex:1;overflow-y:auto;padding:8px}
.poem-card{padding:12px;border-radius:var(--radius-sm);cursor:pointer;transition:all .2s;margin-bottom:6px;border:1px solid transparent;position:relative}
.poem-card:hover{background:var(--warm);border-color:var(--border)}
.poem-card.active{background:var(--warm);border-color:var(--accent)}
.poem-card .pc-title{font-size:14px;font-weight:600;font-family:"Noto Serif SC",Georgia,serif}
.poem-card .pc-author{font-size:11px;color:var(--text2);margin-top:1px}
.poem-card .pc-line{font-size:11px;color:var(--text3);margin-top:4px;line-height:1.5;font-style:italic}
.poem-card .pc-loc{font-size:10px;color:var(--accent);margin-top:4px;display:flex;align-items:center;gap:3px}
.poem-card .pc-dynasty{font-size:9px;padding:1px 6px;border-radius:8px;background:#f3e8ff;color:#7c3aed;font-weight:600;position:absolute;top:10px;right:10px}

.no-result{text-align:center;padding:40px 20px;color:var(--text3);font-size:13px}

/* Poem detail modal */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:800;display:none;align-items:center;justify-content:center;backdrop-filter:blur(4px)}
.modal-bg.show{display:flex}
.modal{background:var(--surface);border-radius:20px;max-width:480px;width:92%;max-height:85vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.15);position:relative}
.modal-close{position:absolute;top:12px;right:12px;width:32px;height:32px;border-radius:50%;background:rgba(0,0,0,.06);border:none;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:10;transition:all .2s}
.modal-close:hover{background:rgba(0,0,0,.12)}
.modal-hero{padding:28px 24px 12px;text-align:center;position:relative}
.modal-hero .mh-dynasty{font-size:11px;color:#7c3aed;font-weight:600;margin-bottom:6px}
.modal-hero .mh-title{font-size:24px;font-weight:700;font-family:"Noto Serif SC",Georgia,serif;letter-spacing:-.3px}
.modal-hero .mh-author{font-size:13px;color:var(--text2);margin-top:4px}
.modal-body{padding:8px 24px 28px}
.modal-body .mh-loc{display:flex;align-items:center;gap:6px;padding:10px 14px;background:var(--warm);border-radius:var(--radius-sm);margin-bottom:16px;font-size:12px}
.modal-body .mh-loc .loc-name{font-weight:600;color:var(--accent)}
.modal-body .mh-text{font-size:16px;line-height:2;font-family:"Noto Serif SC",Georgia,serif;color:var(--text);padding:16px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);text-align:center;white-space:pre-line;letter-spacing:1px}
.modal-body .mh-note{font-size:12px;color:var(--text2);line-height:1.7;margin-top:16px;padding:12px;background:var(--bg);border-radius:var(--radius-sm)}
.modal-body .mh-actions{display:flex;gap:10px;margin-top:16px;justify-content:center;flex-wrap:wrap}
.act-btn{padding:8px 20px;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;border:none;transition:all .2s;display:flex;align-items:center;gap:4px}
.act-btn:hover{transform:scale(1.04)}
.act-btn:active{transform:scale(0.96)}
.act-btn.primary{background:var(--accent);color:#fff}
.act-btn.secondary{background:var(--surface);color:var(--text);border:1px solid var(--border)}

/* Route panel */
.route-panel{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);z-index:400;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-radius:16px;border:1px solid var(--border);padding:10px 16px;display:flex;align-items:center;gap:10px;box-shadow:0 4px 24px rgba(0,0,0,.08);white-space:nowrap}
.route-panel .rp-label{font-size:11px;color:var(--text3)}
.route-panel .rp-name{font-size:13px;font-weight:600;color:var(--accent)}
.route-panel button{background:none;border:1px solid var(--border);border-radius:8px;padding:4px 12px;font-size:11px;cursor:pointer;color:var(--text2);transition:all .2s}
.route-panel button:hover{border-color:var(--accent);color:var(--accent)}
.route-panel button.on{background:var(--accent);color:#fff;border-color:var(--accent)}

/* Leaflet custom */
.leaflet-popup-content-wrapper{background:var(--surface)!important;color:var(--text)!important;border-radius:12px!important;box-shadow:0 4px 20px rgba(0,0,0,.12)!important}
.leaflet-popup-tip{background:var(--surface)!important}
.leaflet-popup-content{margin:10px 14px!important;font-size:12px!important;line-height:1.5}
.custom-marker{background:none;border:none}
.marker-dot{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;box-shadow:0 2px 8px rgba(0,0,0,.15);border:2px solid #fff;transition:transform .2s;cursor:pointer}
.marker-dot:hover{transform:scale(1.3)}

/* Stats bar */
.stats-bar{position:absolute;top:60px;right:16px;z-index:400;display:flex;flex-direction:column;gap:6px}
.stat-chip{background:rgba(255,255,255,.92);backdrop-filter:blur(8px);border-radius:10px;padding:6px 12px;font-size:11px;box-shadow:0 2px 8px rgba(0,0,0,.06);display:flex;align-items:center;gap:4px;border:1px solid rgba(0,0,0,.04)}
.stat-chip .sn{font-weight:700;color:var(--accent);font-size:14px}

@media(max-width:768px){
  .sidebar{display:none}
  .modal{width:96%;max-height:90vh;border-radius:16px}
  .modal-hero .mh-title{font-size:20px}
  .route-panel{bottom:12px;left:12px;right:12px;transform:none;flex-wrap:wrap;justify-content:center}
}
</style>
</head>
<body>

<nav>
  <a href="../index.html" class="back">← 首页</a>
  <span class="title">🏔️ 诗词地图</span>
  <span class="sub">跟着古诗游中国</span>
</nav>

<div class="main">
  <div id="map"></div>

  <div class="sidebar">
    <div class="sidebar-hdr">
      <h2>📜 诗词长廊</h2>
      <div class="count" id="poemCount"></div>
    </div>
    <div class="filters" id="filterBar"></div>
    <div class="search-row">
      <input type="text" placeholder="🔍 搜索诗词、诗人、地名..." id="searchBox" oninput="applyFilter()">
    </div>
    <div class="poem-list" id="poemList"></div>
  </div>
</div>

<div class="modal-bg" id="modalBg" onclick="closeModal()">
  <div class="modal" onclick="event.stopPropagation()">
    <button class="modal-close" onclick="closeModal()">✕</button>
    <div id="modalContent"></div>
  </div>
</div>

<div class="route-panel" id="routePanel">
  <span class="rp-label">诗人足迹：</span>
  <button class="on" onclick="setRoute('all',this)">全部</button>
  <button onclick="setRoute('李白',this)">李白</button>
  <button onclick="setRoute('杜甫',this)">杜甫</button>
  <button onclick="setRoute('苏轼',this)">苏轼</button>
  <button onclick="setRoute('王维',this)">王维</button>
  <button onclick="setRoute('白居易',this)">白居易</button>
</div>

<div class="stats-bar" id="statsBar"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
